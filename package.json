{
  "name": "cryndel-launcher",
  "version": "1.0.0",
  "description": "Cryndel Launcher — Майнкрафт лаунчер для тебя!",
  "main": "electron/main.js",
  "homepage": "https://cryndel.ru",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:windows": "electron-builder --windows",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "test": "jest --config tests/jest.config.js",
    "lint": "eslint --config eslintrc.json electron renderer --ext .js"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "electron",
    "modrinth",
    "cryndel"
  ],
  "author": "Cryndel Team <contact@cryndel.ru>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.12.0",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.1.4",
    "fs-extra": "^11.1.1",
    "uuid": "^9.0.1",
    "ws": "^8.18.0"
  }
}
